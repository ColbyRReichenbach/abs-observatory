# AiBS environment template
# Copy values into `.env` / `.env.local` for local development.
# For staging and production, set the same keys in your hosting/provider dashboards.
# Leave later sections commented out until you are actually wiring those providers.

#############################
# Required now: local database
#############################
# Local Postgres example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abs_observatory
# Managed Postgres example (Neon):
# DATABASE_URL=postgresql://<role>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abs_observatory
DATABASE_SSL=false

#############################
# Optional now: local AI
#############################
# Needed only if you want real model responses instead of local fallback behavior.
# Create/manage keys in OpenAI organization settings.
# OPENAI_API_KEY=
OPENAI_QUERY_MODEL=gpt-4.1-mini
OPENAI_SUMMARY_MODEL=gpt-4.1-mini

#############################
# Optional now: real auth
#############################
# Needed only if you want real Clerk auth instead of dev-header auth in local development.
# Clerk keys:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SIGNING_SECRET=

#############################
# Safe local runtime defaults
#############################
ACTIVE_POLL_SECONDS=30
IDLE_POLL_SECONDS=120
AI_GLOBAL_KILL_SWITCH=false
COMMENTS_GLOBAL_KILL_SWITCH=false
ARTICLE_AUTOPUBLISH_FREEZE=false
SIGNUPS_GLOBAL_KILL_SWITCH=false

# Optional budget controls for local/staging validation.
# AI_DAILY_BUDGET_USD=10
# AI_MONTHLY_BUDGET_USD=100
# AI_MODEL_MONTHLY_BUDGETS_JSON={"gpt-4.1-mini":50}

#############################
# Staging / production: Redis / scale layer
#############################
# Upstash Redis:
# copy the HTTPS REST URL and the standard REST token from the database console
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

#############################
# Staging / production: object storage
#############################
# Cloudflare R2:
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=abs-observatory
# R2_PUBLIC_BASE_URL=https://<public-domain-or-r2-url>
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

#############################
# Staging / production: worker deployment
#############################
# Google Cloud / Cloud Run:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_REGION=us-central1
# CLOUD_RUN_WORKER_URL=https://<your-worker-service-url>
# INTERNAL_WORKER_TOKEN=<random-long-secret>
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_REGION=us-central1
# CLOUD_RUN_WORKER_URL=
# INTERNAL_WORKER_TOKEN=

#############################
# Staging / production: billing
#############################
# BILLING_PROVIDER_SECRET=
# BILLING_WEBHOOK_SECRET=
