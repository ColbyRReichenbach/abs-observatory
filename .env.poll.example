#
# Polling compatibility template
# Canonical live ingest should target Warehouse, not Serving.
# Use GitHub Actions for production polling when possible.
#
WAREHOUSE_DATABASE_URL=
DATABASE_URL=${WAREHOUSE_DATABASE_URL}
DATABASE_SSL=true
MLB_GAME_TYPES=S,R
POLL_INTERVAL_MINUTES=5
POLL_CATCHUP_HOURS=8
POLL_STALE_BACKFILL_HOURS=8
POLL_MAX_BACKFILL_DAYS=7
# See also:
# - .env.poll.local.example for full local archive mode
# - .env.poll.serving.example for trimmed remote warehouse mode
WRITE_RAW_SNAPSHOTS=true
WRITE_RAW_FEED_LIVE=true
WRITE_RAW_STANDINGS=true
WRITE_RAW_SAVANT=true
RUN_SNAPSHOT_PRUNE=false
FEED_LIVE_RETENTION_DAYS=14
STANDINGS_RETENTION_DAYS=0
SAVANT_RETENTION_DAYS=0
